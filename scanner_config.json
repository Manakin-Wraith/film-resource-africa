{
  "_note": "Source of truth for scan_opportunities.mjs. Copy to film-directory repo root. status: active | pending | dead",
  "_repo": "film-directory",
  "version": "1.0",

  "schedule": {
    "cron": "0 6,18 * * *",
    "timezone": "UTC",
    "label": "8am + 8pm SAST"
  },

  "filters": {
    "max_age_days": 90,
    "min_keyword_matches": 2
  },

  "exclude_domains": {
    "_note": "Domains that are never real film opportunities (false-positive sources). Hard-blocked at insert and auto-rejected on re-verify. Add a domain here when a non-film site keeps getting scraped in.",
    "list": [
      "tamassociati.org",
      "eepafrica.org"
    ]
  },

  "llm": {
    "triage": {
      "model": "claude-haiku-4-5-20251001",
      "max_tokens": 150,
      "input": "title + snippet",
      "batch": true
    },
    "classify": {
      "model": "claude-sonnet-4-6",
      "max_tokens": 500,
      "input": "full_page",
      "batch": false
    }
  },

  "relevance_keywords": {
    "regions": [
      "Africa", "African", "pan-African", "sub-Saharan",
      "East Africa", "West Africa", "North Africa", "Southern Africa", "Francophone Africa",
      "South Africa", "Nigeria", "Kenya", "Ethiopia", "Ghana", "Tanzania", "Uganda", "Rwanda",
      "Senegal", "Ivory Coast", "Côte d'Ivoire", "Cameroon", "Zimbabwe", "Zambia", "Mozambique",
      "Angola", "Namibia", "Botswana", "Malawi", "Madagascar", "Mali", "Burkina Faso", "Niger",
      "Chad", "Sudan", "Egypt", "Morocco", "Tunisia", "Algeria", "Libya", "Somalia",
      "DRC", "Congo", "Gabon", "Togo", "Benin", "Guinea", "Sierra Leone", "Liberia",
      "Mauritania", "Eritrea", "Djibouti", "Comoros", "Mauritius", "Seychelles", "Cape Verde",
      "Eswatini", "Lesotho", "Nollywood", "Jollywood"
    ],
    "industry": [
      "film", "filmmaker", "cinema", "documentary", "feature", "short film",
      "script", "screenplay", "screenwriter", "producer", "director",
      "co-production", "post-production", "distribution", "exhibition",
      "festival", "grant", "fund", "fellowship", "residency", "lab", "accelerator",
      "pitch", "development", "commission", "submission", "call for entries", "open call",
      "deadline", "application", "financing", "rebate", "incentive", "market",
      "sales agent", "acquisition"
    ],
    "festivals": [
      "FESPACO", "Durban", "DIFF", "Zanzibar", "ZIFF", "Berlinale", "Cannes",
      "Sundance", "IDFA", "Hot Docs", "Sheffield", "IFFR", "Rotterdam",
      "Tribeca", "NollywoodWeek", "AMVCA", "AFRIFF", "FIFTO"
    ],
    "funders": [
      "NFVF", "Hubert Bals", "Realness", "Docubox", "Maisha", "British Council",
      "BFI", "Bertha", "Catapult", "Chicken & Egg", "Firelight", "Ford Foundation",
      "Doc Society", "World Cinema Fund", "Sørfond", "Visions Sud Est",
      "Afrique Créative", "Ladima", "MultiChoice Talent Factory",
      "Red Sea Fund", "VII Foundation", "CANEX", "Afreximbank"
    ],
    "platforms": [
      "Netflix", "Showmax", "Canal+", "MultiChoice", "MNET",
      "Amazon Prime", "Apple TV", "Disney+", "MUBI", "Afrostream"
    ]
  },

